#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["packaging>=25.0", "rich>=13.0", "tomlkit>=0.13.2"]
# ///
"""Raise every declared lower bound to the version uv resolves.

    any-llm-sdk>=1.22.1,<2   ->   any-llm-sdk>=1.26.0,<2

The resolution is uv's, never ours:

    1. add `[tool.uv] exclude-newer = "7 days"` when the project has none, so
       the cooldown covers the whole graph, transitive packages included;
    2. strip the lower bounds we own, so nothing constrains the resolver;
    3. `uv lock --upgrade` resolves;
    4. write the versions it picked back as `>=`, then `uv sync`.

Without --apply the first three steps still run for real — that is the only way
to know what uv would pick — then `pyproject.toml` and `uv.lock` are restored
byte for byte.

Bounds that come out of a resolution which succeeded are always satisfiable,
and `requires-python`, yanked files, pre-releases and the cooldown are uv's job
rather than something re-implemented here.

The lower bound is the only thing rewritten. `<`, `<=` and `!=` are yours and
are kept — including during the resolution, so the new bound can never step
over a cap. Left alone entirely: direct references (URL/VCS/path), anything
under `[tool.uv.sources]`, and `~=` requirements, whose bound and cap are the
same clause.

An existing `==` is treated as a lower bound and becomes `>=`; this script never
writes a pin. On a library you publish, remember a raised floor is inherited by
everyone who installs it.

  uv-update-dependencies          # dry-run: the bounds uv would write
  uv-update-dependencies --apply  # relock, write the bounds, sync the env
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

import tomlkit
from packaging.requirements import InvalidRequirement, Requirement
from packaging.version import Version
from rich import box
from rich.console import Console
from rich.table import Table

EXCLUDE_NEWER = "7 days"
# The lower bound this script owns and replaces. Everything else (`<`, `<=`,
# `!=`) is yours and survives untouched.
FLOOR = ("==", "===", ">=", ">")


# markup=False: `httpx[http2]` is a requirement, not a Rich style tag.
console = Console(markup=False)


def say(msg: str) -> None:
    # Deliberately not Rich: these carry `[tool.uv]`, which is Rich markup.
    print(f"\033[36m::\033[0m {msg}", file=sys.stderr)


def die(msg: str) -> int:
    print(f"\033[31m!!\033[0m {msg}", file=sys.stderr)
    return 1


def normalize(name: str) -> str:
    """PEP 503 name normalization — how uv.lock spells package names."""
    return re.sub(r"[-_.]+", "-", name).lower()


def find_pyproject() -> Path | None:
    start = Path.cwd().resolve()
    return next((d / "pyproject.toml" for d in (start, *start.parents)
                 if (d / "pyproject.toml").is_file()), None)


def dep_arrays(doc) -> list[tuple[str, list]]:
    """Every array of PEP 508 strings this script manages, with its group name."""
    project = doc.get("project") or {}
    groups = [("project", project.get("dependencies"))]
    groups += [(f"extra:{k}", v) for k, v in (project.get("optional-dependencies") or {}).items()]
    groups += [(k, v) for k, v in (doc.get("dependency-groups") or {}).items()]
    return [(label, array) for label, array in groups if isinstance(array, list)]


def declared(doc) -> list[tuple[str, str]]:
    """Every managed requirement, flattened as (group, text) — the order is
    stable, so two snapshots taken around a rewrite can be zipped into a diff."""
    return [(label, s) for label, array in dep_arrays(doc) for s in array if isinstance(s, str)]


def head(req: Requirement) -> str:
    """`name[extras]` — everything in a requirement that is not a constraint."""
    extras = f"[{','.join(sorted(req.extras))}]" if req.extras else ""
    return f"{req.name}{extras}"


def rewrite(doc, versions: dict[str, str] | None, sources: set[str]) -> None:
    """Rewrite managed requirements in place; `versions=None` only strips bounds.

    Caps and exclusions are kept: they are yours, and honouring them during the
    resolution is what stops the new bound from stepping over one.
    """
    for _, array in dep_arrays(doc):
        for i, raw in enumerate(array):
            if not isinstance(raw, str):  # {include-group = "..."}
                continue
            try:
                req = Requirement(raw)
            except InvalidRequirement:
                continue
            name = normalize(req.name)
            if req.url or name in sources:
                continue
            if any(s.operator == "~=" for s in req.specifier):
                continue  # `~=1.4.2` is a bound and a cap at once — not ours to move
            clauses = [str(s) for s in sorted(req.specifier, key=str)
                       if s.operator not in FLOOR]
            if versions and name in versions:
                clauses.insert(0, f">={versions[name]}")
            marker = f"; {req.marker}" if req.marker else ""
            new = f"{head(req)}{','.join(clauses)}{marker}"
            if new != raw:
                # Markers come back double-quoted, so prefer a TOML literal
                # string over a line full of backslashes.
                literal = '"' in new and "'" not in new
                array[i] = tomlkit.string(new, literal=True) if literal else new


def locked_versions(lock: Path) -> dict[str, str]:
    """name -> version, for the registry packages in the lock.

    A forked resolution (platform or Python markers) can lock one package to
    several versions; the lowest is the only bound every fork satisfies.
    """
    found: dict[str, set[str]] = {}
    for pkg in tomllib.loads(lock.read_text(encoding="utf-8")).get("package", []):
        if "registry" in (pkg.get("source") or {}):
            found.setdefault(normalize(pkg["name"]), set()).add(pkg["version"])
    return {name: min(versions, key=Version) for name, versions in found.items()}


def show(changed: list[tuple[str, str, str]]) -> None:
    """One row per requirement whose text moved, grouped as in the file."""

    def constraint(text: str) -> str:
        """The specifier alone: no `name[extras]` prefix, no marker.

        Cut at the first operator character — a package name cannot hold one,
        and direct references never reach this far.
        """
        body = text.split(";", 1)[0]
        cut = min((body.find(c) for c in "<>=!~" if c in body), default=len(body))
        return body[cut:].strip() or "—"

    rows = [(group, old, Requirement(new), new) for group, old, new in changed]
    # A Marker column only when something has one — most projects never do.
    markers = any(req.marker for *_, req, _ in rows)

    # overflow="fold": a narrow terminal must wrap a version, never elide it.
    table = Table(box=box.SIMPLE_HEAD, header_style="bold", padding=(0, 1))
    table.add_column("Group", style="dim")
    table.add_column("Package", overflow="fold")
    table.add_column("From", justify="right", style="dim", overflow="fold")
    table.add_column("", justify="center", style="dim")
    table.add_column("To", style="bold green", overflow="fold")
    if markers:
        table.add_column("Marker", style="dim", overflow="fold")

    previous = None
    for group, old, req, new in rows:
        if group != previous:
            table.add_section()
        cells = [group if group != previous else "", head(req),
                 constraint(old), "→", constraint(new)]
        if markers:
            cells.append(str(req.marker) if req.marker else "")
        table.add_row(*cells)
        previous = group

    console.print(table)


def uv(args: list[str], cwd: Path) -> int:
    # We run under `uv run --script`, so VIRTUAL_ENV points at this script's own
    # ephemeral env — drop it or uv warns before ignoring it anyway.
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}
    say(f"uv {' '.join(args)}")
    return subprocess.run(["uv", *args], cwd=cwd, env=env, check=False).returncode


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--apply", action="store_true",
                        help="write the bounds and sync (default: dry-run, nothing is kept)")
    apply = parser.parse_args().apply

    path = find_pyproject()
    if path is None:
        return die(f"no pyproject.toml in {Path.cwd()} or any parent")
    if (path.parent / "uv.toml").is_file():
        say("uv.toml present — uv reads it instead of [tool.uv] in pyproject.toml")

    lock = path.parent / "uv.lock"
    original = path.read_text(encoding="utf-8")
    original_lock = lock.read_text(encoding="utf-8") if lock.is_file() else None

    def restore() -> None:
        """Put both files back exactly as they were."""
        path.write_text(original, encoding="utf-8")
        if original_lock is None:
            lock.unlink(missing_ok=True)
        else:
            lock.write_text(original_lock, encoding="utf-8")

    doc = tomlkit.parse(original)
    uv_table = doc.setdefault("tool", tomlkit.table(True)).setdefault("uv", tomlkit.table())
    if "exclude-newer" not in uv_table:
        uv_table["exclude-newer"] = EXCLUDE_NEWER
        say(f'setting [tool.uv] exclude-newer = "{EXCLUDE_NEWER}"'
            + ("" if apply else " (dry-run: not kept)"))

    sources = {normalize(n) for n in (uv_table.get("sources") or {})}
    before = declared(doc)
    rewrite(doc, None, sources)  # strip our bounds so the resolver starts free
    path.write_text(tomlkit.dumps(doc), encoding="utf-8")

    keep = False
    try:
        # A real lock even in dry-run: `--dry-run` would not write the versions
        # we need to show. Both files are restored below when --apply is absent.
        code = uv(["lock", "--upgrade"], path.parent)
        if code:
            return code

        rewrite(doc, locked_versions(lock), sources)
        changed = [(group, old, new)
                   for (group, old), (_, new) in zip(before, declared(doc), strict=True)
                   if old != new]
        if changed:
            show(changed)
        if not apply:
            say(f"dry-run: {len(changed)} bound(s) would change, nothing kept — "
                "re-run with --apply")
            return 0

        path.write_text(tomlkit.dumps(doc), encoding="utf-8")
        keep = True
    finally:
        if not keep:  # dry-run, failure or Ctrl-C — but not `kill -9`
            restore()

    return uv(["sync"], path.parent)  # relock against the new bounds, then install


if __name__ == "__main__":
    sys.exit(main())

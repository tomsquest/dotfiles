#!/bin/bash
# ww: run or raise an app in KDE Plasma (KWin 6, X11 or Wayland). See usage.
#
# How: ww loads a one-shot KWin script that matches windows by desktop file
# (or window class) and activates one. KWin scripts cannot run commands, so
# launching goes through the ww-launch@<app> systemd user unit (kstart).
set -euo pipefail

usage() {
	cat >&2 <<'EOF'
Usage: ww <app>

Run or raise an app:
  no window            launch the app
  window not active    activate its most recent window
  already active       cycle through its windows

<app> is the app's desktop file id, without ".desktop" (e.g. firefox).

Find an app's id: run this, click the app's window, read "desktopFile":
  qdbus6 org.kde.KWin /KWin org.kde.KWin.queryWindowInfo

Bind it to a key:
  System Settings > Shortcuts > Add New > Command > ww <app>
EOF
	exit 1
}

app=${1:-}
if [[ $# -ne 1 || ! $app =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
	usage
fi

script_name="ww-$app"
script_dir="$XDG_RUNTIME_DIR/ww"
script="$script_dir/$app.js"

# The script only depends on $app and on this file: regenerate it only when
# missing or older than this file.
if [[ ! $script -nt $0 ]]; then
	mkdir -p "$script_dir"
	tmp=$(mktemp "$script.XXXXXX")
	cat >"$tmp" <<EOF
// One-shot: unload this script once it has run.
callDBus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", "unloadScript", "$script_name");

const app = "$app";
// Bottom to top: the last one is the most recently active.
const windows = Array.from(workspace.stackingOrder).filter(
    (w) => w.normalWindow && (w.desktopFileName === app || w.resourceClass === app),
);
if (windows.length === 0) {
    callDBus(
        "org.freedesktop.systemd1",
        "/org/freedesktop/systemd1",
        "org.freedesktop.systemd1.Manager",
        "StartUnit",
        "ww-launch@" + app + ".service",
        "replace",
    );
} else {
    // Already in the app: cycle, by raising the window at the bottom.
    const alreadyInApp = windows.includes(workspace.activeWindow);
    workspace.activeWindow = alreadyInApp ? windows[0] : windows[windows.length - 1];
}
EOF
	# Atomic: KWin may be reading the previous version
	mv -f "$tmp" "$script"
fi

kwin() {
	dbus-send --session --dest=org.kde.KWin --print-reply=literal "$@"
}

# The script unloads itself: unloading it from here then loading it right away
# would reuse the id of the not-yet-deleted script, and `run` would hit it.
reply=$(kwin /Scripting org.kde.kwin.Scripting.loadScript "string:$script" "string:$script_name")
id=${reply##* }
if [[ $id == -1 ]]; then
	# Still loaded (previous press running, or left over): skip this press,
	# but unload it so that the next press works
	kwin /Scripting org.kde.kwin.Scripting.unloadScript "string:$script_name" >/dev/null
	exit 0
fi
kwin "/Scripting/Script$id" org.kde.kwin.Script.run >/dev/null

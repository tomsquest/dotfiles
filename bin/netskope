#!/bin/bash
# Toggle NetSkope VPN (system service + user service + tray)

set -euo pipefail

BLUE="\033[1;34m"
GREEN="\033[1;32m"
RESET="\033[0m"

usage() {
    echo -e "${BLUE}Usage: $0 [start|status|stop|restart|reauth]${RESET}"
    echo -e "${BLUE}  start   - Start the NetSkope VPN services and trigger re-authentication${RESET}"
    echo -e "${BLUE}  status  - Status of the NetSkope VPN services${RESET}"
    echo -e "${BLUE}  stop    - Stop the NetSkope VPN services${RESET}"
    echo -e "${BLUE}  restart - Restart the NetSkope VPN services${RESET}"
    echo -e "${BLUE}  reauth  - Open the NetSkope re-authentication window${RESET}"
}

start() {
    echo -e "${BLUE}Starting system service${RESET}"
    sudo systemctl start stagentd.service

    echo -e "${BLUE}Starting user service${RESET}"
    systemctl --user start stagentapp.service

    echo -e "${BLUE}Starting ui (tray)${RESET}"
    dex /usr/share/applications/stagentui.desktop

    echo -e "${GREEN}NetSkope VPN started${RESET}"

    reauth
}

# Click "Re-authenticate Private Access" in the tray menu through D-Bus,
# so the login window opens now instead of after the client's own delay.
reauth() {
    local dbus_dest="netskope-client.stagentapp"
    local dbus_path="/org/ayatana/NotificationItem/com_netskope_stagentui/Menu"
    local dbus_iface="com.canonical.dbusmenu"
    local item_id=""

    echo -e "${BLUE}Triggering re-authentication${RESET}"
    for _ in $(seq 1 30); do
        item_id=$(busctl --user --auto-start=no --json=short call "$dbus_dest" "$dbus_path" "$dbus_iface" \
            GetLayout iias 0 -- -1 0 2> /dev/null \
            | jq -r '[.. | arrays
                | select(length == 3 and (.[0] | type) == "number" and (.[1] | type) == "object")
                | select((.[1].label.data // "") | test("re-?authenticate"; "i"))
                | select(.[1].enabled.data != false)
                | .[0]] | first // empty') || true
        [ -n "$item_id" ] && break
        sleep 1
    done

    if [ -z "$item_id" ]; then
        echo -e "${BLUE}Re-authenticate menu not available, skipping${RESET}"
        return 0
    fi

    busctl --user --auto-start=no call "$dbus_dest" "$dbus_path" "$dbus_iface" \
        Event isvu "$item_id" clicked i 0 "$(date +%s)"
    echo -e "${GREEN}Re-authentication window requested${RESET}"
}

status() {
    systemctl is-active stagentd.service > /dev/null && echo -e "${GREEN}System service: active${RESET}" || echo -e "${BLUE}System service: inactive${RESET}"
    systemctl --user is-active stagentapp.service > /dev/null && echo -e "${GREEN}User service: active${RESET}" || echo -e "${BLUE}User service: inactive${RESET}"
    pgrep -f /opt/netskope/stagent/stAgentUI > /dev/null && echo -e "${GREEN}UI (tray): running${RESET}" || echo -e "${BLUE}UI (tray): not running${RESET}"

    local output pa_status
    if ! command -v nsclient > /dev/null 2>&1; then
        echo -e "${BLUE}Private Access: unavailable (nsclient not found)${RESET}"
        return
    fi

    if ! output=$(timeout 15 nsclient show-pa 2> /dev/null); then
        echo -e "${BLUE}Private Access: unavailable (nsclient show-pa failed)${RESET}"
        return
    fi

    pa_status=$(printf '%s\n' "$output" | sed -n 's/^[[:space:]]*Status:[[:space:]]*//p' | head -n 1)
    if [ -z "$pa_status" ]; then
        echo -e "${BLUE}Private Access: unknown (no status returned)${RESET}"
    elif [[ "$pa_status" == Connected || "$pa_status" == Connected\ * ]]; then
        echo -e "${GREEN}Private Access: ${pa_status}${RESET}"
    else
        echo -e "${BLUE}Private Access: ${pa_status}${RESET}"
    fi
}

stop() {
    echo -e "${BLUE}Stopping system service${RESET}"
    sudo systemctl stop stagentd.service

    echo -e "${BLUE}Stopping user service${RESET}"
    systemctl --user stop stagentapp.service

    echo -e "${BLUE}Stopping ui (tray)${RESET}"
    killall --quiet /opt/netskope/stagent/stAgentUI || true

    echo -e "${GREEN}NetSkope VPN stopped${RESET}"
}

restart() {
    echo -e "${BLUE}Restarting NetSkope VPN...${RESET}"
    stop
    start
}

# Check if a parameter was provided
if [ $# -ge 1 ]; then
    case "$1" in
        start)
            start
            ;;
        status)
            status
            ;;
        stop)
            stop
            ;;
        restart)
            restart
            ;;
        reauth)
            reauth
            ;;
        *)
            echo -e "${BLUE}Invalid option. Usage: $0 [start|status|stop|restart|reauth]${RESET}"
            exit 1
            ;;
    esac
else
    echo -e "${BLUE}No operation provided.${RESET}"
    usage
    exit 1
fi
